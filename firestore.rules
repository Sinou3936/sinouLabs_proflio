// Firestore 보안 규칙 (Firebase 콘솔 > Firestore > 규칙 탭에 붙여넣어 게시)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 방문자 카운터: stats/total, stats/daily_2026-10-26 형태만 허용
    match /stats/{docId} {

      // 허용된 문서 ID인지 확인 (total 또는 daily_날짜)
      function validId() {
        return docId == 'total'
          || docId.matches('daily_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      }

      // 숫자 표시는 누구나 읽기 가능
      allow read: if validId();

      // 오늘 첫 방문: count 필드 하나만, 값은 1로만 생성 가능
      allow create: if validId()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;

      // 이후 방문: count만 바꿀 수 있고 정확히 +1만 허용
      allow update: if validId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1;

      // 삭제는 아무도 불가 (콘솔에서는 가능)
      allow delete: if false;
    }

    // 그 외 모든 경로는 기본 차단
  }
}
